{
  "name": "subah-ai-assistant-android",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Subah AI Assistant - Capacitor Android project",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "cap:init": "npx cap init 'Subah AI Assistant' com.israfil.subahai --web-dir public",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:prepare": "npm run cap:sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
